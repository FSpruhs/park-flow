root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Kotlin-spezifische Regeln
[*.kt]
indent_size = 4
continuation_indent_size = 4
max_line_length = 120

# Kts Skripte (Gradle Kotlin DSL)
[*.kts]
indent_size = 4
continuation_indent_size = 4
max_line_length = 120

# Markdown-Dateien
[*.md]
trim_trailing_whitespace = false

# YAML/JSON (Konfigurationen)
[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2
